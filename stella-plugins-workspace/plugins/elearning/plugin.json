{
  "manifestVersion": 1,
  "id": "stella.elearning",
  "name": "eLearning",
  "version": "1.0.5",
  "hostApi": "^1.0.0",
  "runtime": {
    "kind": "python",
    "entry": "backend/main.py",
    "abi": "cp312"
  },
  "data": {
    "namespace": "stella.elearning",
    "schemaVersion": 1,
    "migrationEntry": "backend/migrate.py"
  },
  "contributes": {
    "services": [
      "stella.elearning@1"
    ],
    "settings": [
      "elearning.account"
    ],
    "pages": [
      "elearning.main"
    ]
  },
  "permissions": [
    {
      "capability": "elearning.read",
      "required": true
    },
    {
      "capability": "elearning.write",
      "required": true
    },
    {
      "capability": "elearning.files",
      "required": true
    }
  ]
}

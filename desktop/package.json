{
  "name": "stella-desktop",
  "version": "0.0.5",
  "description": "Stella Desktop Client - personal AI secretary",
  "main": "dist/main/index.js",
  "author": "Stella",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/sync-version.mjs && npm run build:eventkit && npm run build && node scripts/launch-electron.mjs",
    "dev:hot": "node scripts/sync-version.mjs && concurrently \"npm run dev:renderer\" \"sleep 2 && npm run dev:main\"",
    "dev:main": "npm run build:eventkit && tsc -p tsconfig.main.json && node scripts/launch-electron.mjs --hot-renderer",
    "build:eventkit": "node scripts/build-eventkit.mjs",
    "dev:renderer": "vite --port 5173 --strictPort",
    "build": "node scripts/sync-version.mjs && npm run typecheck && npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "sync:plugin-seed": "node scripts/sync-plugin-seed.mjs",
    "dist": "npm run sync:plugin-seed && npm run build && electron-builder",
    "dist:mac": "npm run sync:plugin-seed && npm run build:eventkit && npm run build && electron-builder --mac",
    "dist:win": "npm run sync:plugin-seed && npm run build && electron-builder --win",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.21.0",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "^6.4.299",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.1",
    "vite": "^6.0.3",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "build": {
    "appId": "com.starpickerr.stella",
    "productName": "Stella",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "build/dist/stella-backend",
        "to": "backend/stella-backend"
      },
      {
        "from": "build/dist/stella-plugin-runner",
        "to": "backend/stella-plugin-runner"
      },
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "icon.png",
          "app-config.json",
          "themes/**",
          "plugin-catalog.json",
          "plugin-seed/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "../native/apple-calendar/.build/StellaCalendarBridge",
          "to": "apple-calendar/StellaCalendarBridge"
        }
      ],
      "extendInfo": {
        "NSCalendarsFullAccessUsageDescription": "Stella synchronizes the calendars you select with your schedules.",
        "NSRemindersFullAccessUsageDescription": "Stella synchronizes the reminder lists you select with your tasks.",
        "NSMicrophoneUsageDescription": "Used for voice input in chat: record a short clip and transcribe it via the configured speech recognition provider."
      },
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "linkify-it": "5.0.2",
    "katex": "$katex",
    "sprintf-js": "^1.1.4"
  },
  "allowScripts": {
    "electron@44.7.0": true
  }
}

{
  "name": "stella-desktop",
  "version": "0.0.4",
  "description": "Stella Desktop Client - personal AI secretary",
  "main": "dist/main/index.js",
  "author": "Stella",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/sync-version.mjs && npm run build && node scripts/launch-electron.mjs",
    "dev:hot": "node scripts/sync-version.mjs && concurrently \"npm run dev:renderer\" \"sleep 2 && npm run dev:main\"",
    "dev:main": "tsc -p tsconfig.main.json && node scripts/launch-electron.mjs --hot-renderer",
    "dev:renderer": "vite --port 5173 --strictPort",
    "build": "node scripts/sync-version.mjs && npm run typecheck && npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.21.0",
    "markdown-it": "^14.2.0",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.1",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.starpickerr.stella",
    "productName": "Stella",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "build/dist/stella-backend",
        "to": "backend/stella-backend"
      },
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "icon.png",
          "app-config.json",
          "themes/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Used for voice input in chat: record a short clip and transcribe it via the configured speech recognition provider."
      },
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "linkify-it": "5.0.2"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
